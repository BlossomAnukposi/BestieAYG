<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules (Android 12+). The manifest sets
    android:allowBackup="false", so cloud-backup and device-transfer are
    already disabled at the framework level. These excludes are defence
    in depth so sensitive files stay on device even if backup is ever
    re-enabled.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="bayg_secure_prefs.xml" />
        <exclude domain="database"   path="bayg.db" />
        <exclude domain="database"   path="bayg.db-journal" />
        <exclude domain="database"   path="bayg.db-wal" />
        <exclude domain="database"   path="bayg.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="bayg_secure_prefs.xml" />
        <exclude domain="database"   path="bayg.db" />
        <exclude domain="database"   path="bayg.db-journal" />
        <exclude domain="database"   path="bayg.db-wal" />
        <exclude domain="database"   path="bayg.db-shm" />
    </device-transfer>
</data-extraction-rules>
