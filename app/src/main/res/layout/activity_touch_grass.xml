<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_touch_grass.xml
    Touch Grass Feature Screen — Nearby Parks

    Dependencies (add to build.gradle if not present):
      implementation 'org.osmdroid:osmdroid-android:6.1.18'
      implementation 'com.google.android.material:material:1.11.0'

    Permissions (add to AndroidManifest.xml):
      <uses-permission android:name="android.permission.INTERNET" />
      <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
      <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    Data sources:
      - Parks: Overpass API  (leisure=park within 1.5km of user location)
          Example query: [out:json];node[leisure=park](around:1500,{lat},{lon});out body;
      - Weather: Open-Meteo API (https://api.open-meteo.com) — no API key required
          https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&current_weather=true
      - Map: osmdroid (OpenStreetMap) rendered in org.osmdroid.views.MapView

    Wire-up: See TouchGrassActivity.kt (create alongside this layout)
      1. On permission grant → get FusedLocationProviderClient.lastLocation
      2. Call Overpass API to fetch parks → populate RecyclerView (id: rv_parks)
      3. Call Open-Meteo → update TextView (id: tv_weather_nudge) and tv_weather_location
      4. Initialize MapView (id: map_view) with osmdroid tiles
      5. For each park, add a Marker to the map; clicking the → button fires:
             val gmmIntentUri = Uri.parse("geo:${park.lat},${park.lon}?q=${Uri.encode(park.name)}")
             startActivity(Intent(Intent.ACTION_VIEW, gmmIntentUri))

    Park item layout: item_park.xml (see separate file)
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1A0F"
    tools:context=".TouchGrassActivity">

    <!-- Collapsing top bar with title -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D1A0F"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingStart="8dp"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="#ADFF6C"
            app:title=""
            app:layout_scrollFlags="scroll|enterAlways"/>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable body -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:clipToPadding="false"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Hero title ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="4dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="touch"
                    android:textColor="#ADFF6C"
                    android:textSize="48sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.02"
                    android:lineSpacingExtra="0dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="grass."
                    android:textColor="#ADFF6C"
                    android:textSize="48sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.02"
                    android:layout_marginTop="-12dp"/>

            </LinearLayout>

            <!-- ── Weather nudge card ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#132418"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <!-- Weather icon -->
                    <ImageView
                        android:id="@+id/iv_weather_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="14dp"
                        android:src="@drawable/ic_weather_sun"
                        android:contentDescription="Weather icon"
                        app:tint="#ADFF6C" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- e.g. "Emmen · 18°C · Partly Cloudy" — set via code -->
                        <TextView
                            android:id="@+id/tv_weather_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Loading weather…"
                            android:textColor="#E8F5E9"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            tools:text="Emmen · 18°C · Partly Cloudy"/>

                        <!-- e.g. "Perfect touch-grass weather, no excuses." -->
                        <TextView
                            android:id="@+id/tv_weather_nudge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#6BAD72"
                            android:textSize="13sp"
                            android:layout_marginTop="3dp"
                            tools:text="Perfect touch-grass weather, no excuses."/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Open data · Open-Meteo"
                            android:textColor="#3D6B42"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp"/>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Optional OSM Map view ── -->
            <!--
                Wire up in TouchGrassActivity.kt:
                  val map = findViewById<org.osmdroid.views.MapView>(R.id.map_view)
                  map.setTileSource(org.osmdroid.tileprovider.tilesource.TileSourceFactory.MAPNIK)
                  map.controller.setZoom(15.0)
                  map.controller.setCenter(GeoPoint(userLat, userLon))
                  // Add markers for each park
            -->
            <org.osmdroid.views.MapView
                android:id="@+id/map_view"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="24dp"
                android:background="#0D1A0F"
                android:clipToOutline="true"/>

            <!-- ── Section header ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nearby Parks"
                    android:textColor="#E8F5E9"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="open data · OpenStreetMap"
                        android:textColor="#3D6B42"
                        android:textSize="12sp"/>

                    <!-- Loading spinner — hide when data loaded: progressBar.visibility = View.GONE -->
                    <ProgressBar
                        android:id="@+id/pb_parks_loading"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="8dp"
                        android:indeterminate="true"
                        android:visibility="visible"/>

                </LinearLayout>
            </LinearLayout>

            <!-- ── Empty state (shown when no parks found; hide via code) ── -->
            <LinearLayout
                android:id="@+id/layout_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_tree"
                    android:contentDescription="No parks found"
                    app:tint="#3D6B42" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No parks found nearby"
                    android:textColor="#6BAD72"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Try expanding the search radius in settings"
                    android:textColor="#3D6B42"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:gravity="center"/>
            </LinearLayout>

            <!--
                ── Parks RecyclerView ──
                Use a LinearLayoutManager (vertical).
                Each item = item_park.xml (see below).

                Adapter wires up:
                  - park name  → tv_park_name
                  - distance   → tv_park_distance  e.g. "0.8 km · ~10 min walk"
                  - "Closest" badge visibility (first item only)
                  - arrow button → opens Google Maps deep-link

                Note: wrap_content height on RecyclerView inside NestedScrollView requires
                      setting hasFixedSize(false) and using LinearLayoutManager.
            -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_parks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_park"
                tools:itemCount="3"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>